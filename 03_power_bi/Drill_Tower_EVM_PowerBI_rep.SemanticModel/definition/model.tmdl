model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Dim_WBS","Dim_Date","Fact_EVM_Periodic","Fact_Gantt_Schedule","Fact_Milestones","Fact_Risk_Register","Fact_Waterfall_Bridge","Fact_Monthly_Burn_Rate","Fact_Financial_Appraisal","Fact_Monte_Carlo"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_WBS
ref table Dim_Date
ref table Fact_EVM_Periodic
ref table Fact_Gantt_Schedule
ref table Fact_Milestones
ref table Fact_Risk_Register
ref table Fact_Waterfall_Bridge
ref table Fact_Monthly_Burn_Rate
ref table Fact_Financial_Appraisal
ref table Fact_Monte_Carlo

